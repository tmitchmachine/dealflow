# Copy to `.env` and fill in values. Never commit real keys.

# Google Places API (New) — finds firm websites, phone, open/closed status for
# `npm run enrich`. Without it, enrichment falls back to verified domain guesses.
# GOOGLE_MAPS_API_KEY=
# Monthly cap on Places calls (one per firm). Default 500.
# PLACES_MONTHLY_CAP=500

# Firestore publish (`npm run publish:deals`) — same form as ironflowlive:
# path to a return-state-team service account JSON file (not inline JSON).
# FIRESTORE_CREDENTIALS=~/secrets/return-state-team-firebase-adminsdk.json
# FIRESTORE_PROJECT_ID=return-state-team

# Firecrawl — Empire Flippers + Flippa marketplace sync (`npm run sync:marketplaces`).
# Daily caps live under data/cache/budget-daily-*.json (10 detail scrapes/day).
# FIRECRAWL_API_KEY=
